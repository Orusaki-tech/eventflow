{
  "__inputs": [],
  "__requires": [],
  "title": "EventFlow API",
  "uid": "eventflow-api",
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate (1m avg)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["p99", "avg"], "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, method, path))",
          "legendFormat": "p99 {{method}} {{path}}",
          "refId": "A"
        }
      ],
      "title": "Request Latency p99 (5m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "rate(http_requests_total{status=~\"5..\"}[5m])",
          "legendFormat": "5xx {{method}} {{path}}",
          "refId": "A"
        }
      ],
      "title": "Error Rate (5xx, 5m avg)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "content": "# EventFlow API\n\n## Health\n- **Uptime:** Check container status\n- **DB:** `GET /api/v1/healthz`\n- **Alerts:** Configured in Prometheus\n", "mode": "markdown" },
      "title": "Status",
      "type": "text"
    }
  ],
  "schemaVersion": 36,
  "tags": ["eventflow", "api"]
}
