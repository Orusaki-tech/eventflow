# deploy/gcp/.env.production — secrets + config for the GCP VM.
#
# Copy to deploy/gcp/.env.production and fill in. NEVER commit the real file.
# `deploy.sh` uploads this file to /opt/eventflow/.env on the VM (root:root, 0600)
# and `docker compose --env-file .env` interpolates it into containers.

# ----- Core -----
ENV=prod
LOG_LEVEL=INFO
ALLOW_UNAUTHENTICATED_LOCAL=false

# ----- HTTP middleware -----
# CSV of origins allowed for browser CORS (full URL: https://host — no trailing slash).
# Native mobile does not use CORS. Example Vercel + local portal:
#   CORS_ALLOW_ORIGINS=https://your-app.vercel.app,http://localhost:3001
CORS_ALLOW_ORIGINS=
# CSV of allowed Host headers (TrustedHostMiddleware, prod-only). Set to your
# public hostname(s) when you put a reverse proxy in front. Use "*" to disable.
# TRUSTED_HOSTS=api.example.com

# ----- Postgres (in-cluster, see docker-compose.yml) -----
# These default to the in-stack postgres service. Override only if you point at
# Supabase / Cloud SQL — in which case set DB_URL instead and remove the local
# postgres service from docker-compose.yml.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=eventflow
DB_USER=eventflow
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Or use a fully-qualified URL (overrides DB_*). Example for Supabase:
# DB_URL=postgresql+psycopg://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres

# ----- Redis (in-cluster) -----
REDIS_URL=redis://redis:6379/0

# ----- Supabase Auth (JWT verification) -----
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# ----- Gemini -----
GEMINI_API_KEY=

# ----- Google Maps (server-side: Places, Directions/ETA, geocoding) -----
GOOGLE_MAPS_API_KEY=

# ----- Google Calendar OAuth -----
# JSON contents of the OAuth client (single line, escape quotes if needed).
GOOGLE_CALENDAR_CREDENTIALS_JSON=
# Fernet key (generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CALENDAR_TOKEN_KEY=
# Must match the redirect URI registered in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=https://<your-domain-or-vm-ip>/api/v1/auth/google/calendar/callback

# ----- Expo push (required for snooze / traffic / reminder notifications) -----
# Create at https://expo.dev/accounts/<account>/settings/access-tokens
# The compose stack must include scheduler + push_sideeffects + push_sender (default).
EXPO_ACCESS_TOKEN=

# ----- Admin console (browser JWT, optional) -----
# Operators: Postgres ``admin_console_allowlist`` (after migrations) or comma-separated ADMIN_USER_IDS env below.
# Vercel: separate admin app project; API DB runs INSERT … ON CONFLICT DO NOTHING with Supabase Auth UIDs as needed.
# ADMIN_USER_IDS=

# ----- Ops checklist (mobile features) -----
# 1) After deploy: migrations run via deploy.sh (`alembic upgrade head` in api container).
# 2) Discover tab / listing carousel: ensure community_events has rows (prod data or seed).
#    Dry-run: python3 scripts/seed_discovery_demo.py --dry-run
#    Seed (optional): python3 scripts/seed_discovery_demo.py --organizer-user-id <uuid>
# 3) If community_events table is missing locally: migrations may have skipped creation
#    when pgvector is unavailable — use Supabase/Postgres with vector extension.

# ----- yt-dlp (Instagram cookies) -----
# Path INSIDE the api container. Mount via docker-compose if you use this.
YTDLP_COOKIE_FILE=
