# Next.js business portal — environment variables
#
# LOCAL: copy to `.env.local` (gitignored):
#   cp .env.example .env.local
#
# VERCEL: Project → Settings → Environment Variables
#   Add each variable for Production (and Preview if you test branch deploys).
#   Redeploy after saving — `NEXT_PUBLIC_*` values are baked at build time.
#
# Use the SAME Supabase project as EventFlow mobile + API (JWT must match).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_EVENTFLOW_API_URL=http://localhost:8000
