# Next.js business portal — environment variables
#
# Operator/admin UI lives in apps/web-admin (separate Vercel project recommended).
#
# LOCAL: copy to `.env.local` (gitignored):
#   cp .env.example .env.local
#
# VERCEL: Project → Settings → Environment Variables → Redeploy after changes.
#   NEXT_PUBLIC_* are baked at build time.
#
# Do NOT put DB_URL / Postgres passwords here — this app never connects to the DB directly.
# Set DB_URL only on the EventFlow API (repo root .env or deploy/gcp/.env.production).

# --- Supabase (same project as mobile + API JWT verification) ---
# Project ref matches repo root .env.example (SUPABASE_JWKS_URL).
# Anon key: Supabase → Settings → API → anon (public) — same value as apps/mobile EXPO_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://enlxdeiitvezfrubhhfv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- EventFlow API ---
# Local dev (browser → API directly):
NEXT_PUBLIC_EVENTFLOW_API_URL=http://localhost:8000
NEXT_PUBLIC_EVENTFLOW_API_PROXY=0

# Vercel PRODUCTION when API is HTTP-only on a VM (fixes mixed content):
#   NEXT_PUBLIC_EVENTFLOW_API_PROXY=1
#   EVENTFLOW_UPSTREAM_URL=http://YOUR_VM_IP:8000
# Do NOT set NEXT_PUBLIC_EVENTFLOW_API_URL to http:// on HTTPS Vercel — the browser will block it.
# Optional: still set NEXT_PUBLIC_EVENTFLOW_API_URL for documentation-only (ignored when proxy=1).

# Server-only: upstream base URL for the Route Handler proxy (no trailing path).
# EVENTFLOW_UPSTREAM_URL=http://34.x.x.x:8000
