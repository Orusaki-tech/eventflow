# Next.js admin console — environment variables
#
# Deploy this app as a separate Vercel project from web-business.
# LOCAL: cp .env.example .env.local
#
# --- Supabase (same project as API JWT verification) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- EventFlow API ---
# Local dev (browser → API directly):
NEXT_PUBLIC_EVENTFLOW_API_URL=http://localhost:8000
NEXT_PUBLIC_EVENTFLOW_API_PROXY=0

# Vercel HTTPS → HTTP upstream VM (same pattern as web-business):
# NEXT_PUBLIC_EVENTFLOW_API_PROXY=1
# EVENTFLOW_UPSTREAM_URL=http://YOUR_VM_IP:8000

# Server-only: upstream base for Route Handler proxy (no trailing slash).
# EVENTFLOW_UPSTREAM_URL=http://34.x.x.x:8000
