# Copy to .env — Expo loads variables from here for app.config / client.
# https://docs.expo.dev/guides/environment-variables/

# Backend API — must use a server with DB_URL set to Postgres (e.g. Supabase) or data won’t persist.
# After `bash deploy/gcp/deploy.sh`, apps/mobile/.env.deployment is written automatically; app.config
# uses it when this variable is unset. Set EXPO_PUBLIC_EVENTFLOW_API_URL here or in .env.local to override.
# EXPO_PUBLIC_EVENTFLOW_API_URL=http://localhost:8000

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Supabase dashboard snippets may use this name instead (publishable key works here too):
# EXPO_PUBLIC_SUPABASE_KEY=

# Same name as server-side Maps key (repo root .env). Baked into native Android MapView via app.config.ts.
GOOGLE_MAPS_API_KEY=

# Legacy fallback only — prefer GOOGLE_MAPS_API_KEY above.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# iOS native / EAS: set your Apple Developer Team ID so app.config can pass ios.appleTeamId (Expo warns if missing).
# Use .env locally or Expo Dashboard → Environment variables / `eas env:create` for cloud builds.
# EXPO_PUBLIC_APPLE_TEAM_ID=XXXXXXXXXX
