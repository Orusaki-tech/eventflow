# Copy to .env — Expo loads variables from here for app.config / client.
# https://docs.expo.dev/guides/environment-variables/

# Backend API — must use a server with DB_URL set to Postgres (e.g. Supabase) or data won’t persist.
EXPO_PUBLIC_EVENTFLOW_API_URL=http://localhost:8000

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Supabase dashboard snippets may use this name instead (publishable key works here too):
# EXPO_PUBLIC_SUPABASE_KEY=

# Same name as server-side Maps key (repo root .env). Baked into native Android MapView via app.config.ts.
GOOGLE_MAPS_API_KEY=

# Legacy fallback only — prefer GOOGLE_MAPS_API_KEY above.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional (iOS builds / Xcode)
# EXPO_PUBLIC_APPLE_TEAM_ID=
