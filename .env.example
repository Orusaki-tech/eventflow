# Core
ENV=local
LOG_LEVEL=INFO

# HTTP middleware
# CSV of origins allowed for browser CORS preflight. Leave empty in non-prod —
# the API auto-allows "*" then. In prod, list explicit origins, e.g.:
#   CORS_ALLOW_ORIGINS=https://app.example.com,http://localhost:8081
# Native React Native fetches (iOS/Android) are NOT subject to CORS, so this
# only matters for Expo Web, an admin web UI, or curl/browser dashboards.
# CORS_ALLOW_ORIGINS=
#
# CSV of hostnames allowed in the Host header (only enforced when ENV=prod).
# Set to your public hostname(s) once behind a reverse proxy. Use "*" to disable.
# TRUSTED_HOSTS=api.example.com

# Persistence + messaging
#
# The mobile Supabase SDK does NOT persist EventFlow data by itself. Drafts, events, and
# budgets are stored by THIS API in Postgres. Set DB_URL to your Supabase project's database
# (same project as SUPABASE_* auth below), then run: alembic upgrade head
#
# Supabase Postgres (recommended here since auth is Supabase):
# Dashboard → Project Settings → Database → Connection string → URI.
# Use the direct host `db.<project-ref>.supabase.co:5432` or Session pooler (not Transaction mode)
# for DDL — Alembic migrations need a session-capable connection.
# Scheme must match SQLAlchemy + psycopg v3: postgresql+psycopg://
# Example:
# DB_URL=postgresql+psycopg://postgres:<YOUR_DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
# URL-encode special characters in the password (e.g. @ → %40).
#
# Local Postgres alternative:
# Option A (recommended): specify DB_* parts and let EventFlow construct DB_URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eventflow
DB_USER=eventflow
DB_PASSWORD=secret
# Optional extra query params (example): sslmode=require
# DB_QUERY=sslmode=require
#
# Option B: provide full SQLAlchemy URL (overrides DB_*):
# DB_URL=postgresql+psycopg://eventflow:secret@localhost:5432/eventflow
# Recommended when ENV=dev|prod: backs POST /api/v1/share/url parse cache + image preview tokens.
# When ENV=local and REDIS_URL is unset, the API uses an in-memory fallback for carousel preview tokens only.
REDIS_URL=redis://localhost:6379/0

# Supabase Auth (JWT verification)
SUPABASE_JWKS_URL=https://enlxdeiitvezfrubhhfv.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://enlxdeiitvezfrubhhfv.supabase.co/auth/v1

# AI parsing (Gemini Developer API — google-genai uses Generative Language API)
GEMINI_API_KEY=
# Optional override (default gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
#
# If imports fail with 403 PERMISSION_DENIED / SERVICE_DISABLED for generativelanguage.googleapis.com:
# 1) The key belongs to Google Cloud project NUMBER shown in the error (GCP Console → project picker → that project's Settings → note Project number).
# 2) In THAT SAME project: APIs & Services → Enable APIs → enable "Generative Language API" (not only Vertex AI).
# 3) Billing must be enabled on that project if Google prompts for it.
# 4) Restart the API process/container after changing GEMINI_API_KEY so it picks up the new key.
# 5) API key restrictions: if the key is restricted to Android/iOS apps only, SERVER requests from EventFlow will fail — use "Don't restrict" or restrict by IP for your host.
# Quick check (replace KEY): curl -sS "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=KEY" -H "Content-Type: application/json" -d '{"contents":[{"parts":[{"text":"ping"}]}]}'

# Google Maps: Places autocomplete, Directions/ETA, geocoding (server). Same env name in apps/mobile/.env for native MapView.
GOOGLE_MAPS_API_KEY=

# Calendar
GOOGLE_CALENDAR_CREDENTIALS_JSON=
CALENDAR_TOKEN_KEY=
GOOGLE_OAUTH_REDIRECT_URI=

# Push (Expo)
EXPO_ACCESS_TOKEN=

# yt-dlp (optional; improves Instagram reliability)
# Path to a Netscape cookies.txt file (mount into container for Docker).
YTDLP_COOKIE_FILE=

